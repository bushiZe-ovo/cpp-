{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "运行 week3 题目",
      "type": "process",
      "command": "/bin/bash",
      "args": [
        "${workspaceFolder}/run.sh",
        "${input:exercise}"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ],
  "inputs": [
    {
      "id": "exercise",
      "type": "pickString",
      "description": "选择运行题目",
      "options": [
        "01_static_data",
        "02_student",
        "03_static_function",
        "5-13_friend",
        "5-3_scope",
        "5-7_cat"
      ]
    }
  ]
}
